# ── LeJEPA-METER Secrets ───────────────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# All hyperparameters are now in configs/config.yaml and configs/experiment/*.yaml

# HuggingFace token (optional, avoids rate limiting)
HF_TOKEN=

# HF_OFFLINE=true  → read only from local HuggingFace cache (no network)
# HF_OFFLINE=false → stream from HuggingFace (downloads what is missing)
HF_OFFLINE=false

# ── Dataset paths ─────────────────────────────────────────────────────
# Path to local NYU Depth V2 tar archives (train-000000.tar, train-000001.tar, ...).
# If set, loads from local .tar/.h5 files instead of HuggingFace streaming.
# Can be relative (resolved from project root) or absolute.
# If unset/empty, falls back to HuggingFace streaming.
NYU_DATASET_PATH=datasets/nyu

# Path to preprocessed NYU memory-mapped .npy files (created by: uv run python -m src.preprocess 192 256).
# If set and files exist, training uses mmap for near-zero RAM overhead.
NYU_MMAP_DIR=datasets/nyu_mmap

# Path to KITTI raw data directory (contains eigen_train_files.txt, data_depth_annotated.zip, etc.).
# Can be relative (resolved from project root) or absolute.
KITTI_DATASET_PATH=datasets/kitti

# Path to preprocessed KITTI memory-mapped .npy files (created by: uv run python -m src.preprocess --dataset kitti 192 640).
# If set and files exist, KITTI training uses mmap for near-zero RAM overhead.
KITTI_MMAP_DIR=datasets/kitti_mmap
